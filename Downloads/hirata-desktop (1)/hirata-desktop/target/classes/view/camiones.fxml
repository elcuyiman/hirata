<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hirata.controller.CamionController"
            stylesheets="@style.css">

    <left>
        <VBox spacing="10" styleClass="sidebar">
            <Label text="Hirata" styleClass="sidebar-title"/>

            <Button text="Dashboard" onAction="#volverDashboard" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Camiones" styleClass="sidebar-button-active" maxWidth="Infinity"/>
            <Button text="Kilometraje" onAction="#irKilometraje" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Mantenimientos" onAction="#irMantenimientos" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Trabajadores" onAction="#irTrabajadores" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button text="Alertas" onAction="#irAlertas" styleClass="sidebar-button" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="sidebar-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" pannable="true">
            <content>
                <VBox spacing="20" styleClass="main-container">
                    <padding>
                        <Insets top="20" right="24" bottom="24" left="24"/>
                    </padding>

                    <VBox spacing="4">
                        <Label text="Gestión de Camiones" styleClass="page-title"/>
                        <Label text="Registra camiones y asigna o quita trabajadores mediante RUT."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <!-- FORMULARIO CAMIÓN -->
                    <VBox spacing="16" styleClass="card">
                        <Label text="Nuevo camión" styleClass="section-title"/>

                        <GridPane hgap="14" vgap="14">
                            <Label text="Placa" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-muted"/>
                            <TextField fx:id="txtPlaca" promptText="Ej: ABC123" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                            <Label text="Modelo" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="label-muted"/>
                            <TextField fx:id="txtModelo" promptText="Ej: Volvo FH" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Año" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="label-muted"/>
                            <TextField fx:id="txtAnio" promptText="Ej: 2024" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                            <Button text="Guardar camión"
                                    onAction="#guardarCamion"
                                    styleClass="primary-button"
                                    GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        </GridPane>

                        <Label fx:id="lblMensaje"/>
                    </VBox>

                    <!-- ASIGNACIÓN DE TRABAJADOR -->
                    <VBox spacing="16" styleClass="card">
                        <Label text="Asignar trabajador por RUT" styleClass="section-title"/>

                        <HBox spacing="12">
                            <TextField fx:id="txtRutTrabajador" promptText="RUT del trabajador"/>
                            <Button text="Asignar trabajador" onAction="#asignarTrabajadorPorRut" styleClass="success-button"/>
                            <Button text="Quitar trabajador" onAction="#quitarTrabajador" styleClass="warning-button"/>
                        </HBox>
                    </VBox>

                    <!-- TABLA -->
                    <VBox spacing="14" styleClass="card">
                        <Label text="Listado de camiones" styleClass="section-title"/>

                        <TableView fx:id="tableCamiones" prefHeight="380">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                                <TableColumn fx:id="colPlaca" text="Placa" prefWidth="180"/>
                                <TableColumn fx:id="colModelo" text="Modelo" prefWidth="260"/>
                                <TableColumn fx:id="colAnio" text="Año" prefWidth="120"/>
                                <TableColumn fx:id="colTrabajadorId" text="Trabajador ID" prefWidth="140"/>
                            </columns>
                        </TableView>

                        <HBox spacing="12">
                            <Button text="Eliminar seleccionado" onAction="#eliminarCamion" styleClass="danger-button"/>
                            <Button text="Actualizar lista" onAction="#actualizarTabla" styleClass="secondary-button"/>
                        </HBox>
                    </VBox>

                    <HBox spacing="10">
                        <Button text="Volver al dashboard" onAction="#volverDashboard" styleClass="secondary-button"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>